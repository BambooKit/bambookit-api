{
  "name": "bambookit-api",
  "version": "0.2.0",
  "private": true,
  "description": "BambooKit control plane: auth, devices, QR pairing, session registry, remote commands, approvals, realtime",
  "engines": { "node": ">=22.13" },
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.8",
    "@hono/zod-validator": "^0.4.3",
    "dotenv": "^16.4.7",
    "hono": "^4.7.4",
    "jose": "^5.10.0",
    "typescript": "^5.8.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "tsx": "^4.19.3",
    "vitest": "^3.0.7"
  }
}
