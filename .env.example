NODE_ENV=development
PORT=8080
LOG_LEVEL=info
DATABASE_PATH=./data/bambookit.db
CORS_ORIGINS=http://localhost:3000
# Supabase project used for auth. Never put the service-role key here.
SUPABASE_URL=https://your-project.supabase.co
# Publishable/anon key. Needed to verify tokens on legacy HS256 projects via /auth/v1/user.
SUPABASE_ANON_KEY=
# Optional: legacy HS256 JWT secret. If set, tokens are verified locally.
SUPABASE_JWT_SECRET=
PAIRING_TOKEN_TTL_SECONDS=120
