NODE_ENV=development
PORT=8080
LOG_LEVEL=info
DATABASE_PATH=./data/bambookit.db
CORS_ORIGINS=http://localhost:3000
# Supabase project used for auth. Never put the service-role key here.
SUPABASE_URL=https://your-project.supabase.co
# Publishable/anon key. Needed to verify tokens on legacy HS256 projects via /auth/v1/user.
SUPABASE_ANON_KEY=
# Optional: legacy HS256 JWT secret. If set, tokens are verified locally.
SUPABASE_JWT_SECRET=
PAIRING_TOKEN_TTL_SECONDS=120
# Firebase project used as the Google identity provider (Supabase third-party auth)
FIREBASE_PROJECT_ID=

# Postgres instead of SQLite (required on Render free tier, whose disk is wiped on restart)
# Supabase -> Project settings -> Database -> Connection string (Session pooler)
POSTGRES_URL=
# Origin used in share links
PUBLIC_SHARE_BASE_URL=https://bambookit-web.onrender.com

# --- Cloudflare R2 (profile photos, 7-day session history copies). Server-side only. ---
# Cloudflare dashboard -> R2 -> Manage API tokens (Object Read & Write, this bucket only).
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Optional; defaults to https://<CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=
# Days a session history copy is kept (also add an R2 lifecycle rule for users/*/sessions/).
SESSION_SNAPSHOT_DAYS=7
# Local development without R2: STORAGE_DRIVER=memory
STORAGE_DRIVER=

# --- Account deletion ---
# Supabase -> Project settings -> API keys -> service_role (secret). Server-side only, never in apps.
SUPABASE_SERVICE_ROLE_KEY=
# Firebase web API key (public; same as the apps use) to delete Google one-tap accounts.
FIREBASE_API_KEY=
